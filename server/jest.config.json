{
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": "tsconfig.test.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "testMatch": ["<rootDir>/src/**/*.spec.ts"],
  "collectCoverageFrom": ["src/**/*.ts", "!src/generated/**", "!src/main.ts"],
  "coverageDirectory": "coverage",
  "watchman": false
}
